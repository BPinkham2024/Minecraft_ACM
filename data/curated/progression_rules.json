{
  "version": 1,
  "description": "Earliest supported access milestone, independent of frequency, time cost, annotations, and classifier outputs.",
  "tier_definitions": {
    "early": "Basic Overworld gathering, crafting, and ordinary encounters",
    "mid": "Tool-gated mining, specialist stations, and Overworld exploration",
    "late": "Nether access and configured advanced Overworld exploration",
    "end-game": "End access and End boss rewards"
  },
  "assumptions": [
    "Tier boundaries are an editable project rubric, not hardcoded per-item labels or official Minecraft stages.",
    "Natural biome availability is assumed; search time is not priced. All supported routes are considered, including rare loot.",
    "Nether access uses a bucket-built portal, so a diamond pickaxe is not mandatory. Lava/water availability and stronghold search are assumed at their respective milestones.",
    "Source gates establish prerequisites, not a combat simulator or complete action plan. Reusable tools and stations are required but not consumed.",
    "Unreviewed and placed-block sources remain excluded; missing manual actions are not invented. Empty/zero-observation loot cannot seed a route.",
    "Minimum proof depth breaks ties within a milestone; this does not promise the fastest or cheapest route."
  ],
  "evidence": {
    "recipes_and_tool_requirements": "Bundled data/raw/recipes and data/raw/tags/blocks from Java 1.20.1",
    "smithing_reference": "https://minecraft.wiki/w/Template:Smithing/doc",
    "mining_reference": "https://openaccess.thecvf.com/content/CVPR2025/supplemental/Li_Optimus-2_Multimodal_Minecraft_CVPR_2025_supplemental.pdf",
    "access_policy": "Dimension/source assignments and milestone boundaries are project-authored scenario assumptions, kept separate from verified recipe inputs."
  },
